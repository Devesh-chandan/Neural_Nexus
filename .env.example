# Copy to backend/.env and fill in. Never commit the real file.

# ── LLM explanations (optional; the app falls back to deterministic templates) ──
# groq | anthropic | openai | none
LLM_PROVIDER=none
# Groq key (used when LLM_PROVIDER=groq). Other providers use LLM_API_KEY.
GROQ_API_KEY=
LLM_API_KEY=
# Model id your account can use. Leave empty for the provider default; a 401/403/404 from the
# provider disables LLM calls until restart (check this value first).
LLM_MODEL=

# ── Database (PostgreSQL, e.g. the Supabase database connection string) ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── Supabase auth ──
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Backend only. Never expose this key through a VITE_ variable or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ── HTTP ──
# Allowed browser origins (comma-separated)
CORS_ORIGINS=http://localhost:5173
# Rate limiting (in-process, per worker). RATE_LIMIT_SCALE multiplies every limit.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SCALE=1.0
# Set true ONLY behind a trusted reverse proxy (nginx in docker-compose) so the client IP is read
# from X-Forwarded-For. Leave false when the API is exposed directly.
TRUST_PROXY_HEADERS=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
