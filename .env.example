# LLM provider: anthropic | openai | none
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# SQLite database path (relative to backend/)
DB_PATH=data/nexus.db

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Supabase project configuration.
# The public/anon key is safe for browser use when RLS is enabled.
SUPABASE_URL=https://qwqdccbbpyqysjcjeqya.supabase.co
SUPABASE_ANON_KEY=
# Backend only. Never expose this key through a VITE_ variable or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
